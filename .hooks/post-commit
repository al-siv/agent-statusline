#!/bin/sh
# Цепочка к общему AI-трекеру Qoder. В этом репозитории задан core.hooksPath=.hooks,
# что перекрывает штатный <repo>/.git/hooks/post-commit установщика, поэтому без
# этого вызова трекер здесь не запустится. Единый скрипт для всех таких репо
# разворачивается из ~/dev/agent-instructions: ~/.qoder-cn/hooks/qoder-post-commit.sh
chain="$HOME/.qoder-cn/hooks/qoder-post-commit.sh"
[ -f "$chain" ] || { echo "post-commit: $chain missing — run ./sync.sh push in ~/dev/agent-instructions" >&2; exit 0; }
exec sh "$chain"
